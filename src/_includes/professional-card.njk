<article class="professional-card" id="{{ professional.id }}" aria-labelledby="{{ professional.id }}-name">
  <header class="professional-header">
  <img class="professional-portrait" src="{{ professional.photo }}"
    width="460" height="460" alt="{{ professional.name }}"
    loading="lazy" decoding="async" />
  <div class="professional-heading">
    <h3 id="{{ professional.id }}-name">{{ professional.name }}</h3>
    <p class="professional-role">{{ professional.headline }}</p>
  </div>
  </header>
  <p class="professional-bio">{{ professional.bio }}</p>
    {% if professional.website or professional.github or professional.linkedin %}
    <div class="professional-links">
      {% if professional.website %}
      <a href="{{ professional.website }}" aria-label="{{ professional.name }}’s website"
        >Website <span aria-hidden="true">↗</span></a
      >
      {% endif %}
      {% if professional.github %}
      <a href="{{ professional.github }}" aria-label="{{ professional.name }} on GitHub"
        >GitHub <span aria-hidden="true">↗</span></a
      >
      {% endif %}
      {% if professional.linkedin %}
      <a href="{{ professional.linkedin }}" aria-label="{{ professional.name }} on LinkedIn"
        >LinkedIn <span aria-hidden="true">↗</span></a
      >
      {% endif %}
    </div>
    {% endif %}
</article>
