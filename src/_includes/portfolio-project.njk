<article class="project-card" id="{{ project.id }}" aria-labelledby="{{ project.id }}-title">
  <p class="project-name">{{ project.name }}</p>
  <h3 id="{{ project.id }}-title">{{ project.title }}</h3>
  <p class="project-description">{{ project.description }}</p>
  {% if project.status %}<p class="project-stage">{{ project.status }}</p>{% endif %}
  <a class="project-link" href="{{ project.url }}">{{ project.linkLabel }}</a>
</article>
