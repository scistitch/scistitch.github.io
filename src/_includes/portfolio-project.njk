<article class="portfolio-project" id="{{ project.id }}" aria-labelledby="{{ project.id }}-title">
  <header class="portfolio-project-heading">
    <p class="eyebrow">{{ project.area }}</p>
    <h3 id="{{ project.id }}-title">{{ project.name }}</h3>
    <p class="portfolio-summary">{{ project.summary }}</p>
    <p class="project-status">{{ project.status }}</p>
    <p class="project-contribution">{{ project.contribution }}</p>
    <ul class="project-technologies" aria-label="{{ project.name }} technologies and concepts">
      {% for technology in project.technologies %}<li>{{ technology }}</li>{% endfor %}
    </ul>
    <div class="portfolio-links">
      {% for link in project.links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
    </div>
  </header>
  <div class="portfolio-project-body">
    <dl class="project-reasoning">
      <div><dt>The problem</dt><dd>{{ project.problem }}</dd></div>
      <div><dt>The approach</dt><dd>{{ project.approach }}</dd></div>
      <div><dt>Where this experience helps</dt><dd>{{ project.relevance }}</dd></div>
    </dl>
    {% if project.id == "arx" %}
    <details class="ecosystem-details">
      <summary>Explore the Arx ecosystem components</summary>
      <p class="ecosystem-intro">Core packages now live in the Arx monorepo. The former standalone ASTx and IRx repositories and the earlier C++ compiler are archived. Related tools have their own release cycles and limits.</p>
      {% for group in arxEcosystem %}
      <section class="ecosystem-group" aria-labelledby="arx-group-{{ loop.index }}">
        <h4 id="arx-group-{{ loop.index }}">{{ group.title }}</h4>
        <dl class="ecosystem-components">
          {% for component in group.items %}
          <div>
            <dt><a href="{{ component.url }}">{{ component.name }}</a></dt>
            <dd>{{ component.description }}<span>{{ component.status }}</span></dd>
          </div>
          {% endfor %}
        </dl>
      </section>
      {% endfor %}
      <a class="text-link" href="https://github.com/arxlang">Browse all Arx repositories</a>
    </details>
    {% endif %}
  </div>
</article>
