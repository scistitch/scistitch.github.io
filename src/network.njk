---
layout: "base.njk"
permalink: "/network/"
title: "Professional Network — SciStitch"
description: "SciStitch’s professional network: its founder and independent researchers, engineers, and specialists who collaborate according to project needs and availability."
ogTitle: "Professional Network — SciStitch"
ogDescription: "SciStitch’s professional network: its founder and independent researchers, engineers, and specialists who collaborate according to project needs and availability."
contact: {"eyebrow": "Start with your project", "title": "Let’s explore<br />the right expertise.", "description": "Tell us your goals and the expertise you need. We can discuss possible collaborators, availability, and a suitable scope.", "href": "mailto:connect@scistitch.com?subject=A%20project%20for%20SciStitch", "label": "Discuss your project"}
---
      <section class="hero page-hero container" aria-labelledby="hero-title">
        <p class="hero-eyebrow eyebrow">
          <span class="status-dot" aria-hidden="true"></span> Professional Network
        </p>
        <div class="hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">Independent expertise.<br /><span>Shared purpose.</span></h1>
            <p class="hero-description">
              Researchers, statisticians, software engineers, and specialists
              connected by a commitment to meaningful scientific and societal work.
            </p>
            <p class="hero-description">
              Active members contribute to current initiatives or coordination.
              The wider network stays connected for relevant opportunities.
              Independent collaborators are not SciStitch employees.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="/services/"
                >Explore our services <span aria-hidden="true">↗</span></a
              >
              <a class="text-link" href="/challenges/#join"
                >How to join <span aria-hidden="true">↗</span></a
              >
            </div>
          </div>
          <figure class="hero-figure page-figure">
            <div class="figure-top">
              <span>PEOPLE × EXPERTISE</span><span aria-hidden="true">[ {{ professionals | length }} ]</span>
            </div>
            <img src="/assets/professional-network.svg" width="500" height="415"
              alt="Six individual figures linked by curved blue lines, representing independent professionals connected through collaboration."
              fetchpriority="high" />
            <figcaption>
              <span class="figure-caption-mark" aria-hidden="true">+</span>
              Different perspectives. Shared goals.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="team-section section-pad network-active" id="active-members" aria-labelledby="active-members-title">
        <div class="container network-directory">
          <div class="section-heading network-section-heading">
            <div>
              <p class="eyebrow section-label"><span>01 /</span> Currently engaged</p>
              <h2 id="active-members-title">Active Members</h2>
            </div>
            <p>People currently contributing to SciStitch initiatives or their coordination. This reflects present engagement, not a permanent ranking.</p>
          </div>
          <div class="professional-grid professional-grid--active">
            {% for professional in professionals | sort(attribute="name") %}
              {% if professional.status == "active" %}
                {% include "professional-card.njk" %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="team-section section-pad network-wider" id="professional-network" aria-labelledby="professionals-title">
        <div class="container network-directory">
          <div class="section-heading network-section-heading">
            <div>
              <p class="eyebrow section-label"><span>02 /</span> Connected expertise</p>
              <h2 id="professionals-title">Professional Network</h2>
            </div>
            <p>Independent collaborators who share our mission and may join future challenges or engagements according to their skills and availability.</p>
          </div>
          <div class="professional-grid">
            {% for professional in professionals | sort(attribute="name") %}
              {% if professional.status != "active" %}
                {% include "professional-card.njk" %}
              {% endif %}
            {% endfor %}
          </div>
          <div class="network-join">
            <p>Interested in joining through meaningful existing work or a real, institution-guided open challenge?</p>
            <a class="text-link" href="/challenges/#join">Explore ways to join <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      {% include "contact.njk" %}
